# Copy to .env (never commit it). Get these from developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_SANDBOX_SECRET=your-sandbox-secret
# Optional: xAI second opinion (console.x.ai > API Keys). Also set "owner_confirmed_zdr": true in
# policy.json ONLY after you turn on Zero Data Retention for your xAI team (Console > Team Settings).
# XAI_API_KEY=your-xai-api-key
# Optional: any OpenAI-compatible chat endpoint for a plain-English summary (e.g. local Ollama)
# CHECKER_LLM_URL=http://127.0.0.1:11434/v1/chat/completions   (must be on this machine)
# CHECKER_LLM_MODEL=llama3.2
# Optional but recommended: key that signs the audit log (any long random string). If unset, a 0600 key file
# is created next to the log. Keep it where the agent can't read it.
# CHECKER_AUDIT_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"
